# Copy to .env (local) or set in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Never paste secrets into chat.

# ── Database ─────────────────────────────────────────────
# Local development: embedded Postgres stored in ./.data (no account needed)
DATABASE_URL=pglite:./.data/pglite
# Production (Supabase > Project Settings > Database > Connection pooling, port 6543):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEFAULT_OUTLET=versova
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Razorpay (start with TEST keys: rzp_test_...) ────────
# Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > add https://<your-domain>/api/webhooks/razorpay
# events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
# Local development without Razorpay keys: a fake gateway (ignored in production)
PAYMENTS_MODE=simulator

# ── Supabase Realtime (optional; pages fall back to polling) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Scheduled jobs ───────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# ── Messaging (MSG91: WhatsApp + SMS) ──────────────────────────────
# Without MSG91_AUTH_KEY, dev prints messages (incl. login codes) to the
# server console; production sends nothing.
MSG91_AUTH_KEY=
# WhatsApp number connected in MSG91, with country code (e.g. 91XXXXXXXXXX)
MSG91_WA_NUMBER=
# Secret appended to the delivery-report webhook URL:
#   https://<site>/api/webhooks/msg91?token=<MSG91_WEBHOOK_TOKEN>
MSG91_WEBHOOK_TOKEN=
# Approved WhatsApp template NAMES (variables in the order listed in Admin > Messages)
MSG91_WA_TPL_OTP=
MSG91_WA_TPL_ORDER_PLACED=
MSG91_WA_TPL_ORDER_READY=
MSG91_WA_TPL_ORDER_OUT_FOR_DELIVERY=
MSG91_WA_TPL_ORDER_COMPLETED=
MSG91_WA_TPL_ORDER_CANCELLED=
MSG91_WA_TPL_ORDER_REFUNDED=
MSG91_WA_TPL_STAFF_ALERT=
# DLT-approved SMS Flow template IDs (fallback when WhatsApp fails)
MSG91_SMS_TPL_OTP=
MSG91_SMS_TPL_ORDER_PLACED=
MSG91_SMS_TPL_ORDER_READY=
MSG91_SMS_TPL_ORDER_OUT_FOR_DELIVERY=
MSG91_SMS_TPL_ORDER_CANCELLED=
MSG91_SMS_TPL_ORDER_REFUNDED=
# MSG91 OTP widget for phone login (public values from MSG91 > OTP > Widget).
# When set together with MSG91_AUTH_KEY, MSG91 sends/resends/verifies login codes
# (its own templates, WhatsApp/SMS, captcha) and the server confirms each login.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=
# Max login codes per day across the site (OTP-pumping guard), alert threshold per hour
OTP_DAILY_CAP=300
OTP_ALERT_PER_HOUR=40

# ── Email (Resend, optional) ───────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Seiketsu <orders@your-domain>"

# Temporary test logins (no SMS) — "phone:code,phone:code". Delete before launch.
TEST_LOGINS=
