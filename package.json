{
  "name": "seiketsu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/db && npm run typecheck -w web",
    "db:generate": "npm run generate -w @seiketsu/db",
    "db:migrate": "npm run migrate -w @seiketsu/db",
    "db:seed": "npm run seed -w @seiketsu/db",
    "lint": "npm run lint -w web",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "deploy:check": "tsx --env-file-if-exists=.env scripts/deployment-check.ts",
    "db:move": "tsx --env-file-if-exists=.env scripts/move-database.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "packageManager": "npm@11.9.0"
}
